@page "/users"
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@using Radzen
@inject NavigationManager Navigation
@rendermode InteractiveServer


<PageTitle>Users Management - Inspection Pro</PageTitle>

<div class="users-container">
    <!-- Page Header -->
    <div class="page-header">
        <h1><i class="fas fa-users"></i> Users Management</h1>
    </div>

  

    <!-- Search and Filters -->
    <div-- class="search-section">
        <div class="search-bar">
            <i class="fas fa-search"></i>
            <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="Search users by name, email, or role..." />
        </div>
        <!--div class="filter-group">
            <select class="filter-select" @bind="RoleFilter">
                <option value="">All Roles</option>
                <option value="admin">Administrator</option>
                <option value="inspector">Inspector</option>
                <option value="manager">Manager</option>
            </select>
            <select class="filter-select" @bind="StatusFilter">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div-->
        <br />
    </div>
   

    <!-- Users Table -->
    <div class="table-and-quick-actions">
        <div class="users-table-container">
            <div class="table-header">
                <h2><i class="fas fa-list"></i> All Users</h2>
                <div class="table-actions">
                    <span>@FilteredUsers.Count users</span>
                </div>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Department</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in PagedUsers)
                    {
                        <tr @onclick="() => SelectUser(user)"
                            class="@(SelectedUser?.Email == user.Email ? "selected-row" : "")"
                            style="cursor:pointer;">
                            <td>
                                <div class="user-info">
                                    <div class="user-avatar">@GetUserInitials(user.FullName, user.LastName)</div>
                                    <div class="user-details">
                                        <div class="user-fullName"> @($"{user.FullName} {user.LastName}".ToUpper())</div>
                                        <div class="user-email">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="role-badge role-@user.Role">
                                    @GetRoleDisplayName(user.Role)
                                </span>
                            </td>
                            <td>@user.Department</td>
                        
                            <td>
                                <span class="status-badge status-@user.Status">
                                    @user.Status.ToUpper()
                                </span>
                            </td>
                       
                        </tr>
                    }
                </tbody>
            </table>
        </div>


     

        <!-- Quick Actions Panel (right side) -->
        <div class="users-table-quickAction"
    
            <div class="table-header">
                <h2><i class="fas fa-user"></i>Quick Actions</h2>
            </div>
            <div class="quick-actions-panel">
                <!--button class="action-btn refresh" @onclick="RefreshData">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button-->
                <button class="action-btn add" @onclick="OnAddNavigation">
                    <i class="fas fa-user-plus"></i> Add New
                </button>
        
                <button class="action-btn edit" @onclick="EditUser">
                    <i class="fas fa-edit"></i> Edit User
                </button>
                <button class="action-btn delete"  @onclick="() => ConfirmDelete(SelectedUser)"
                        disabled="@(SelectedUser == null)">
                    <i class="fas fa-trash"></i> Delete User
                </button>
            </div>
        </div>
    </div>

    <div class="pager-container">
        <RadzenPager Count="@count"
                     PageSize="@pageSize"
                     PageNumbersCount="6"
                     PageChanged="@PageChanged" />
    </div>


</div>


<!-- Loading Indicator -->
@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">
            <i class="fas fa-spinner fa-spin"></i>
            <p>Loading users, please wait...</p>
        </div>
    </div>
}
@if (ShowDeleteDialog)
{
    <div class="modal-backdrop-custom" @onclick="CancelDelete"></div>

    <div class="modal-container">
        <div class="modal-card">

            <!-- Header -->
            <div class="modal-header">
                 <h5>Confirm Deletion</h5>
                <div class="warning-icon">⚠️</div>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <p>
                    Are you sure you want to delete
                    <b>@UserToDelete?.FullName @UserToDelete?.LastName</b>?
                </p>
                <p class="text-muted small">
                    This action cannot be undone.
                </p>
            </div>

            <!-- Footer -->
            <div class="modal-footer">

                 <button class="Btn delete-btn" @onclick="DeleteConfirmed">
                    Yes, Delete
                </button>
                <button class="btn btn-outline-secondary" @onclick="CancelDelete">
                    Cancel
                </button>

            </div>

        </div>
    </div>
}
@code {

    User? SelectedUser;
    private List<User> Users = new();
    private List<User> FilteredUsers = new();
    private User CurrentUser = new();
    private bool ShowModal = false;
    private bool EditingUser = false;
    private bool IsLoading = false;
    private string LoadingMessage = "";
    private string roleFilter = "";
    private string statusFilter = "";
    private string SuccessMessage = "";
    private string ErrorMessage = "";
    private string searchTerm = "";
    private int pageSize = 4;
    private int pageIndex = 0;
    private int count => FilteredUsers.Count;
    private bool ShowDeleteDialog = false;
    private User? UserToDelete;
    private IEnumerable<User> PagedUsers =>
        FilteredUsers.Skip(pageIndex * pageSize).Take(pageSize);


    void PageChanged(Radzen.PagerEventArgs args)
    {
        pageIndex = args.PageIndex;
    }


    private string SearchTerm
    {
        get => searchTerm;
        set
        {
            searchTerm = value;
            FilterUsers();
        }
    }
    private string StatusFilter
    {
        get => statusFilter;
        set
        {
            statusFilter = value;
            FilterUsers();
        }
    }
    private string RoleFilter
    {
        get => roleFilter;
        set
        {
            roleFilter = value;
            FilterUsers();
        }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSampleData();
        }
    }
    
    private async Task LoadSampleData()
    {
        try
        {
            IsLoading = true;
            LoadingMessage = "Loading Users...";
            await InvokeAsync(StateHasChanged); 

            var result = await Http.GetFromJsonAsync<List<User>>(
                "https://localhost:7043/api/users/all"
            );

            Users = result ?? new List<User>();

            FilterUsers(); 
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Users = new List<User>();
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged); 
        }
    }
    private void FilterUsers()
    {
        var filtered = Users.AsEnumerable();

        if (!string.IsNullOrEmpty(SearchTerm))
        {
            filtered = filtered.Where(u =>
                ($"{u.FullName} {u.LastName}").Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                u.Department.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
            );
        }

        if (!string.IsNullOrEmpty(RoleFilter))
        {
            filtered = filtered.Where(u => u.Role == RoleFilter);
        }

        if (!string.IsNullOrEmpty(StatusFilter))
        {
            filtered = filtered.Where(u => u.Status == StatusFilter);
        }

        FilteredUsers = filtered.ToList();
        
    }

    private string GetUserInitials(string firstName, string lastName)
    {
        return string.Concat(
            string.IsNullOrEmpty(firstName) ? "" : firstName[0].ToString().ToUpper(),
            string.IsNullOrEmpty(lastName) ? "" : lastName[0].ToString().ToUpper()
        );
    }

    private string GetRoleDisplayName(string role) => role switch
    {
        "admin" => "Administrator",
        "inspector" => "Inspector",
        "manager" => "Manager",
        _ => role
    };

    private string FormatDate(DateTime? date) => date.HasValue ? date.Value.ToString("MMM dd, yyyy") : "-";

    private void ShowAddUserModal()
    {
        CurrentUser = new User { Status = "active" };
        EditingUser = false;
        ShowModal = true;
    }

    private void EditUser(User user)
    {
        if (user != null)
        {
            CurrentUser = new User
            {
                FullName = user.FullName,
                LastName = user.LastName,
                Email = user.Email,
                Role = user.Role,
                Department = user.Department,
                //LastLogin = user.LastLogin,
                Status = user.Status
            };
            EditingUser = true;
            ShowModal = true;
        }
    }

    private void CloseModal()
    {
        ShowModal = false;
        SuccessMessage = "";
        ErrorMessage = "";
        CurrentUser = new User();
    }

   

    private async Task OnAddNavigation()
    {
        Navigation.NavigateTo("/AddUsers");
    }
    void EditUser()
    {
        if (SelectedUser != null)
        {
            Navigation.NavigateTo($"/edit-user/{SelectedUser.Email}");
        }
    }

  


    private async Task RefreshData()
    {
        IsLoading = true;
        LoadingMessage = "Refreshing data...";
        StateHasChanged();
        await Task.Delay(1000);
        LoadSampleData();
        IsLoading = false;
        
    }
    void SelectUser(User user)
    {
        SelectedUser = user;
    }
    private async Task DeleteConfirmed()
    {
        if (UserToDelete == null)
            return;

        var response = await Http.DeleteAsync(
            $"https://localhost:7043/api/users/delete-by-email/{UserToDelete.Email}"
        );

        if (response.IsSuccessStatusCode)
        {
            Users.Remove(UserToDelete);
            FilterUsers();
            SelectedUser = null;
        }

        ShowDeleteDialog = false;
        UserToDelete = null;
    }

    private void ConfirmDelete(User user)
    {
        UserToDelete = user;
        ShowDeleteDialog = true;
    }
    private void CancelDelete()
    {
        ShowDeleteDialog = false;
        UserToDelete = null;
    }
    public class User
    {
       
        public string FullName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string Status { get; set; } = "active";
        public string password { get; set; } = "";
    
    }
}