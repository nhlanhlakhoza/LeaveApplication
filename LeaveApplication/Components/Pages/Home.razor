@page "/dashboard"
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@using LeaveApplication.Components.Services
@using Radzen
@rendermode InteractiveServer
@inject UserStateService UserStateService
@using System.IdentityModel.Tokens.Jwt
@inject IJSRuntime JS

<PageTitle>Dashboard - Leave Application</PageTitle>

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <h1><i class="fas bi-house-door"></i> Dashboard</h1>
    </div>

    <!-- Summary Cards -->
    <div class="summary-cards">
        <div class="summary-card missing">
            <div class="card-icon">
                <i class="fas fa-briefcase-medical"></i>
            </div>
            <div class="card-content">
                <h3>@LeaveData?.SickLeaveDays</h3>
                <p>Sick leave</p>
            </div>
        </div>

        <div class="summary-card pending">
            <div class="card-icon">
                <i class="fas fa-suitcase-rolling"></i>
            </div>
            <div class="card-content">
                <h3>@LeaveData?.AnnualLeaveDays</h3>
                <p>Annual leave</p>
            </div>
        </div>

        <div class="summary-card completed">
            <div class="card-icon">
                <i class="fas fas fa-users"></i>
            </div>
            <div class="card-content">
                <h3> @LeaveData?.FamilyLeaveDays</h3>
                <p>Family leave</p>
            </div>
        </div>

   
    </div>

   
               
               

               
            </div>
            <!-- Paginator -->
            <RadzenPager Count="@TotalInspectors"
                         PageSize="@pageSize"
                         @bind-PageIndex="@pageIndex"
                         PageNumbersCount="6"
                         Style="margin-top:20px; display:flex; justify-content:center;" />


        


@code {
   
    private string ActiveFilter = "all";

    private List<TaskItem> alTasks = new();     // ALL tasks 
    private List<TaskItem> Tasks = new();       // TOP 5 
    private List<TaskItem> FilteredTasks = new();
    private List<Inspector> Inspectors = new();

    private int PendingCount;
    private int CompletedCount;
    private int SubmittedCount;
    private int OverdueCount;
    private string UserEmail = "";
    private LeaveSummaryDto LeaveData;
    private int pageSize = 4;
    private int pageIndex = 0;
    public string Email { get; set; } = "";
    private int TotalInspectors => Inspectors.Count;
 
    private IEnumerable<Inspector> PagedInspectors =>
     Inspectors
         .Skip(pageIndex * pageSize)
         .Take(pageSize);

    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUserFromToken();

      
            if (!string.IsNullOrEmpty(UserEmail))
            {
                await LoadLeave();    
               
              
            }

            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task LoadUserFromToken()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (string.IsNullOrEmpty(token)) return;

            var handler = new JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(token);

           
            UserEmail = jwt.Claims.FirstOrDefault(c => c.Type == "Email")?.Value ?? "";
         

            Email = UserEmail;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("JWT READ ERROR: " + ex.Message);
        }
    }
 
   
    private async Task LoadLeave()
    {
        try
        {
            LeaveData = await Http.GetFromJsonAsync<LeaveSummaryDto>(
                $"https://localhost:7043/api/Leave/totals/{UserEmail}"
            );
            Console.WriteLine($"Annual: {LeaveData?.AnnualLeaveDays}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            LeaveData = null;
        }
    }
    private void SetFilter(string filter)
    {
        ActiveFilter = filter;
       
    }
      private async Task LoadReportTo()
    {
        try
        {
            Inspectors = await Http.GetFromJsonAsync<List<Inspector>>("https://localhost:7272/api/users/reportsTo") ?? new();
            pageIndex = 0; 
        }
        catch
        {
            Inspectors = new();
        }
    }
    

    private string GetStatIcon(string statType) => statType.ToLower() switch
    {
        "missing" => "fas fa-exclamation-circle",
        "in progress" => "fas fa-sync-alt",
        "pending" => "fas fa-clock",
        "completed" => "fas fa-check-circle",
        _ => "fas fa-tasks"
    };

    public class TaskItem
    {
        public string Title { get; set; } = "";
        public string Priority { get; set; } = "";
        public DateTime DueDate { get; set; }
        public string AssignedTo { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public string description  {get; set; } = "";
    }

    public class Inspector
    {
        public string Avatar { get; set; } = "";
        public string fullName { get; set; } = "";
        public int AssignedCount { get; set; }
        public string StatType { get; set; } = "";
        public int StatCount { get; set; }
    }

    public class Leave
    {
      
        public string Email { get; set; } = "";
        
    }

    public class LeaveSummaryDto
    {
        public int AnnualLeaveDays { get; set; }
        public int SickLeaveDays { get; set; }
        public int FamilyLeaveDays { get; set; }
    }
}
