@page "/AddUsers"
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@using Radzen
@inject NavigationManager Navigation
@rendermode InteractiveServer
<PageTitle>Add User </PageTitle>

<div class="users-container">
    <!-- Page Header -->
    <div class="page-header">
        <h1><i class="fas fa-user-plus me-2"></i> Add New Employee</h1>
    </div>
    </div>
<!-- Form -->
  <div class="card-body p-4">
                    <form method="post" class="row g-3 align-items-start">
                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1">First Name</label>
                        </div>
                        <div class="col-12 col-md-8">
                            <input asp-for="Employee.FirstName" class="form-control" placeholder="e.g., John" required autofocus />
                            <span asp-validation-for="Employee.FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1">Last Name</label>
                        </div>
                        <div class="col-12 col-md-8">
                            <input asp-for="Employee.LastName" class="form-control" placeholder="e.g., Doe" required />
                            <span asp-validation-for="Employee.LastName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1">Email Address</label>
                        </div>
                        <div class="col-12 col-md-8">
                            <input asp-for="Employee.Email" class="form-control" type="email" placeholder="e.g., john.doe@company.com" required />
                            <span asp-validation-for="Employee.Email" class="text-danger small"></span>
                        </div>
                         <div class="col-12 col-md-4">
                          <label class="form-label mb-1">Employee Number</label>
                        </div>
                            <div class="col-12 col-md-8">
                             <input asp-for="Employee.EmployeeNumber" class="form-control"  placeholder="ICT12223" required />
                        <span asp-validation-for="Employee.EmployeeNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1">Gender</label>
                        </div>
                        <div class="col-12 col-md-8">
                            <select asp-for="Employee.Gender" class="form-select" required>
                                <option value="">Select Gender...</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1">Position</label>
                        </div>
                        <div class="col-12 col-md-8">
                            <select asp-for="Employee.Position" class="form-select" required>
                                <option value="">Select Position...</option>
                                <option value="Software Developer">Software Developer</option>
                                <option value="System Administrator">System Administrator</option>
                                <option value="IT Support">IT Support</option>
                                <option value="Project Manager">Project Manager</option>
                                <option value="Manager">Manager</option>
                              
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1">Department</label>
                        </div>
                        <div class="col-12 col-md-8">
                            <select asp-for="Employee.Department" class="form-select" required>
                                <option value="">Select Department...</option>
                                <option value="ICT">ICT</option>
                                <option value="Development">Development</option>
                                <option value="Support">Support</option>
                                <option value="HR">HR</option>
                                <option value="Finance">Finance</option>
                            </select>
                        </div>

                        <!-- Buttons -->
                        <div class="col-12 mt-4 text-end">
            <button type="submit" class="btn save-btn px-5 py-2 me-3">
                                Save
                            </button>
            <a asp-page="/users" class="btn btn-outline-secondary px-5 py-2" @onclick="OnNavigation">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
       

@code {

    private async Task OnNavigation()
    {
        Navigation.NavigateTo("/users");
    }

}
