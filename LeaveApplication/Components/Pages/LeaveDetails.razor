@page "/leave-details/{id:int}"
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject NavigationManager Navigation
@rendermode InteractiveServer
@using System.IdentityModel.Tokens.Jwt
@using System.IO

<PageTitle>Leave Details</PageTitle>

<div class="users-container">

    <div class="page-header">
        <h1><i class="fas fa-calendar-alt"></i> Leave Details</h1>
    </div>

    @if (LeaveData == null)
    {
        <p>No leave found</p>
    }
    else
    {
        <div class="card p-3">

            <div class="leave-card">

                
                <div class="leave-grid">

                    <div class="leave-item">
                        <label>Employee Name</label>
                        <span>@LeaveData.employeeName</span>
                    </div>

                    <div class="leave-item">
                        <label>Leave Type</label>
                        <span>@LeaveData.leaveType</span>
                    </div>

                    <div class="leave-item">
                        <label>Start Date</label>
                        <span>@LeaveData.StartDate?.ToString("yyyy-MM-dd")</span>
                    </div>

                    <div class="leave-item">
                        <label>End Date</label>
                        <span>@LeaveData.EndDate?.ToString("yyyy-MM-dd")</span>
                    </div>

                    <div class="leave-item">
                        <label>Number of Days</label>
                        <span>@LeaveData.numberOfDays</span>
                    </div>
                    <div class="leave-item">
                        <label>Status</label>
                        <span>@LeaveData.Status</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(LeaveData.documentPath))
                {
                    <div class="document-section">
                        <p class="doc-title">Attached Document</p>

                        <button class="btn-view-doc" @onclick="ViewDocument">
                            <i class="fas fa-file-pdf"></i> View Document
                        </button>
                    </div>
                }
                 
                <div class="action-options d-flex gap-3">

                    <!-- APPROVE -->
                    <label class="custom-check">
                        <input type="checkbox"
                               checked="@(SelectedAction == 1)"
                               @onchange="() => SelectAction(1)" />

                        <span class="checkmark"></span>
                        <span class="text-success ms-2">
                            <i class="fas fa-check"></i> Approve
                        </span>
                    </label>

                    <!-- REJECT -->
                    <label class="custom-check">
                        <input type="checkbox"
                               checked="@(SelectedAction == 2)"
                               @onchange="() => SelectAction(2)" />

                        <span class="checkmark"></span>
                        <span class="text-danger ms-2">
                            <i class="fas fa-times"></i> Reject
                        </span>
                    </label>

                </div>
                <br />
                <!-- SHOW REASON ONLY IF REJECT -->
                @if (ShowReject)
                {
                    <div class="mt-5">
                        <textarea class="form-control"
                                  @bind="RejectReason"
                                      placeholder="Enter rejection reason (required)">
        </textarea>
                        </div>
                    }
            </div>

          

    <!-- Buttons -->
    <div class="action-buttons mt-3">
                    <button class="btn btn-approve px-4"
                @onclick="SubmitAction"
                            disabled="@IsSubmitDisabled">
            Submit
        </button>

        <button class="btn btn-outline-secondary px-4 ms-2"
                @onclick="CancelAction">
            Cancel
        </button>
    </div>

</div>
           
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger mt-2">@ErrorMessage</div>
            }

            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <div class="alert alert-success mt-2">@SuccessMessage</div>
            }
        }
    </div>

    @if (IsLoading)
    {
        <div class="loading-overlay">
            <div class="loading-spinner">
                <i class="fas fa-spinner fa-spin"></i>
                <p>Saving leave details...</p>
            </div>
        </div>
    }
    @if (ShowPdfViewer)
    {
        <div class="pdf-overlay">

            <div class="pdf-container">

                <div class="pdf-header">
                    <h5>Leave Document Preview</h5>

                    <button class="close-btn" @onclick="ClosePdf">✖</button>
                </div>

                <div class="pdf-body">
                    <iframe src="@PdfUrl"></iframe>
                </div>

            </div>

        </div>
    }
@code {

    [Parameter] public int id { get; set; }

    private Leave? LeaveData;
    private bool IsLoading = false;
    private bool ShowReject = false;
    private string RejectReason = "";
    private bool _loaded;
    private bool ShowPdfViewer = false;
    private string PdfUrl = "";
    private string ErrorMessage = "";
    private string SuccessMessage = "";
    private int SelectedAction = 0; // 0 = nothing, 1 = approve, 2 = reject
    private string userEmail = "";
    private string ApproverEmail = "";
    private string RejectionReason = "";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_loaded)
        {
            _loaded = true;
            await LoadUserFromToken();
            await LoadLeave();
        }
    }
    private async Task LoadUserFromToken()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");

            if (string.IsNullOrEmpty(token)) return;

            var handler = new JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(token);

            userEmail = jwt.Claims.FirstOrDefault(c => c.Type == "Email")?.Value ?? "";
            ApproverEmail = userEmail;
        }
        catch (Exception ex)
        {
            Console.WriteLine("JWT ERROR: " + ex.Message);
        }
    }
    private async Task LoadLeave()
    {
        try
        {
            IsLoading = true;
            await InvokeAsync(StateHasChanged);

            LeaveData = await Http.GetFromJsonAsync<Leave>(
                $"https://localhost:7043/api/leave/{id}"
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            LeaveData = null;
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    private void SelectAction(int action)
    {
        SelectedAction = action;

        if (action == 2) // Reject
        {
            ShowReject = true;

        }
        else // Approve
        {
            ShowReject = false;



        }
    }
    private bool IsSubmitDisabled =>
    SelectedAction == 0 ||
    (SelectedAction == 2 && string.IsNullOrWhiteSpace(RejectReason));
    private async Task SubmitAction()
    {
        ErrorMessage = "";
        SuccessMessage = "";

        if (SelectedAction == 0)
        {
            ErrorMessage = "Please select Approve or Reject";
            return;
        }

        if (SelectedAction == 2 && string.IsNullOrWhiteSpace(RejectReason))
        {
            ErrorMessage = "Rejection reason is required";
            return;
        }

        try
        {
            IsLoading = true;

            if (SelectedAction == 1)
            {
                RejectionReason="null";
            }else if (SelectedAction ==2){
                RejectionReason = RejectReason;
            }
            var url =
                $"https://localhost:7043/api/Leave/process/{id}" +
                $"?approverEmail={ApproverEmail}&action={SelectedAction}&rejectionReason={RejectionReason}";

           
            var response = await Http.PutAsync(url, null);
            IsLoading = false;

            if (response.IsSuccessStatusCode)
            {
                SuccessMessage = SelectedAction == 1
                    ? "Leave Approved successfully"
                    : "Leave Rejected successfully";

                await InvokeAsync(StateHasChanged);
                await Task.Delay(3000);
                Navigation.NavigateTo("/ApproveLeave");
            }
            else
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ViewDocument()
    {
        if (string.IsNullOrEmpty(LeaveData?.documentPath))
            return;

        var fileName = Path.GetFileName(LeaveData.documentPath);

        PdfUrl = $"/LeaveDocuments/{fileName}";
        ShowPdfViewer = true;
    }

    private void ClosePdf()
    {
        ShowPdfViewer = false;
        PdfUrl = "";
    }

    private void CancelAction()
    {
        Navigation.NavigateTo("/ApproveLeave");
    }

    public class Leave
    {
        public int id { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string leaveType { get; set; } = "";
        public string Status { get; set; } = "";
        public int numberOfDays { get; set; }
        public string employeeEmail { get; set; } = "";
        public string employeeName { get; set; } = "";
        public string documentPath { get; set; } = "";
    }
}