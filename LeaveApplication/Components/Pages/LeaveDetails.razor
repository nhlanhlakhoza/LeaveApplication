@page "/leave-details/{id:int}"
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject NavigationManager Navigation
@rendermode InteractiveServer
@using System.IdentityModel.Tokens.Jwt
@using System.IO

<PageTitle>Leave Details</PageTitle>

<div class="users-container">

    <div class="page-header">
        <h1><i class="fas fa-calendar-alt"></i> Leave Details</h1>
    </div>

    @if (IsLoading)
    {
       
    }
    else if (LeaveData == null)
    {
        <p>No leave found</p>
    }
    else
    {
        <div class="card p-3">

            <div class="leave-card">

                
                <div class="leave-grid">

                    <div class="leave-item">
                        <label>Employee Name</label>
                        <span>@LeaveData.employeeName</span>
                    </div>

                    <div class="leave-item">
                        <label>Leave Type</label>
                        <span>@LeaveData.leaveType</span>
                    </div>

                    <div class="leave-item">
                        <label>Start Date</label>
                        <span>@LeaveData.StartDate?.ToString("yyyy-MM-dd")</span>
                    </div>

                    <div class="leave-item">
                        <label>End Date</label>
                        <span>@LeaveData.EndDate?.ToString("yyyy-MM-dd")</span>
                    </div>

                    <div class="leave-item">
                        <label>Number of Days</label>
                        <span>@LeaveData.numberOfDays</span>
                    </div>
                    <div class="leave-item">
                        <label>Status</label>
                        <span>@LeaveData.Status</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(LeaveData.documentPath))
                {
                    <div class="document-section">
                        <p class="doc-title">Attached Document</p>

                        <button class="btn-view-doc" @onclick="ViewDocument">
                            <i class="fas fa-file-pdf"></i> View Document
                        </button>
                    </div>
                }

            </div>

           
            <div class="action-buttons">

                <button class="btn btn btn-approve" @onclick="Approve">
                    <i class="fas fa-check"></i> Approve
                </button>

                <button class="btn btn-reject" @onclick="ShowRejectBox">
                    <i class="fas fa-times"></i> Reject
                </button>

                <button class="btn  btn-outline-secondary" @onclick="CancelAction">
                    Cancel
                </button>

            </div>
            @if (ShowReject)
            {
                <div class="mt-3">
                    <textarea class="form-control"
                              @bind="RejectReason"
                                  placeholder="Enter rejection reason">
                    </textarea>

                        <br />

                        <button class="btn btn btn-approve" @onclick="Reject">
                            Submit Reject
                        </button>
                    </div>
                }

            </div>
        }
    </div>

    @if (IsLoading)
    {
        <div class="loading-overlay">
            <div class="loading-spinner">
                <i class="fas fa-spinner fa-spin"></i>
                <p>Loading leave details...</p>
            </div>
        </div>
    }
    @if (ShowPdfViewer)
    {
        <div class="pdf-overlay">

            <div class="pdf-container">

                <div class="pdf-header">
                    <h5>Leave Document Preview</h5>

                    <button class="close-btn" @onclick="ClosePdf">✖</button>
                </div>

                <div class="pdf-body">
                    <iframe src="@PdfUrl"></iframe>
                </div>

            </div>

        </div>
    }
@code {

    [Parameter] public int id { get; set; }

    private Leave? LeaveData;
    private bool IsLoading = false;
    private bool ShowReject = false;
    private string RejectReason = "";
    private bool _loaded;
    private bool ShowPdfViewer = false;
    private string PdfUrl = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_loaded)
        {
            _loaded = true;
            await LoadLeave();
        }
    }

    private async Task LoadLeave()
    {
        try
        {
            IsLoading = true;
            await InvokeAsync(StateHasChanged);

            LeaveData = await Http.GetFromJsonAsync<Leave>(
                $"https://localhost:7043/api/leave/{id}"
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            LeaveData = null;
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Approve()
    {
        await Http.PutAsync(
            $"https://localhost:7043/api/leave/approve/{id}",
            null
        );

        Navigation.NavigateTo("/leaveHistory");
    }

    private void ShowRejectBox()
    {
        ShowReject = true;
    }

    private async Task Reject()
    {
        await Http.PutAsJsonAsync(
            $"https://localhost:7043/api/leave/reject/{id}",
            RejectReason
        );

        Navigation.NavigateTo("/leaveHistory");
    }

    private void ViewDocument()
    {
        if (string.IsNullOrEmpty(LeaveData?.documentPath))
            return;

        var fileName = Path.GetFileName(LeaveData.documentPath);

        PdfUrl = $"/LeaveDocuments/{fileName}";
        ShowPdfViewer = true;
    }

    private void ClosePdf()
    {
        ShowPdfViewer = false;
        PdfUrl = "";
    }

    private void CancelAction()
    {
        Navigation.NavigateTo("/ApproveLeave");
    }

    public class Leave
    {
        public int id { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string leaveType { get; set; } = "";
        public string Status { get; set; } = "";
        public int numberOfDays { get; set; }
        public string employeeEmail { get; set; } = "";
        public string employeeName { get; set; } = "";
        public string documentPath { get; set; } = "";
    }
}