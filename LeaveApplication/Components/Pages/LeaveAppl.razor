@page "/applyLeave"
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject UserStateService UserStateService
@using System.IdentityModel.Tokens.Jwt
@using LeaveApplication.Components.Services
@using Radzen.Blazor
@using Radzen
@inject IJSRuntime JS

<PageTitle>Apply Leave</PageTitle>

<div class="users-container">
    <div class="page-header">
        <h1><i class="fas fa-calendar-alt me-2"></i> Apply Leave</h1>
    </div>
</div>

<div class="card-body p-4">
    <EditForm Model="Leave" OnValidSubmit="ApplyLeave" class="row g-3">
        <DataAnnotationsValidator />

            <InputText @bind-Value="Leave.Email" class="form-control" hidden />
       
            <InputText @bind-Value="Leave.EmployeeName" class="form-control" hidden />
       
        <!-- Leave Type -->
        <div class="col-12 col-md-4">
            <label>Leave Type</label>
        </div>
        <div class="col-12 col-md-8">
            <InputSelect @bind-Value="Leave.LeaveType"
                         class="form-select"
                         @onchange="CalculateDays">
                <option value="">Select Leave Type</option>
                <option value="Annual">Annual</option>
                <option value="Sick">Sick</option>
                <option value="Family">Family</option>
            </InputSelect>
        </div>

        <!-- Start Date -->
        <div class="col-12 col-md-4">
            <label>Start Date</label>
        </div>
        <div class="col-12 col-md-8">
            <InputDate @bind-Value="Leave.StartDate"
                       class="form-control"
                       @onchange="CalculateDays" />
        </div>

        <!-- End Date -->
        <div class="col-12 col-md-4">
            <label>End Date</label>
        </div>
        <div class="col-12 col-md-8">
            <InputDate @bind-Value="Leave.EndDate"
                       class="form-control"
                       @onchange="CalculateDays" />
        </div>
        <!-- Reason -->
        <div class="col-12 col-md-4">
            <label>Reason</label>
        </div>
        <div class="col-12 col-md-8">
            <InputTextArea @bind-Value="Leave.Reason" class="form-control" />
        </div>
        @if (Leave.LeaveType == "Sick" || Leave.LeaveType == "Family")
        {
            <div class="col-12 col-md-4 d-flex align-items-center">
                <label class="mb-0">
                    <i class="bi bi-paperclip me-2"></i> Supporting Document
                </label>
            </div>

            <div class="col-12 col-md-8">
                <div class="input-group shadow-sm rounded">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-cloud-arrow-up text-primary"></i>
                    </span>

                    <InputFile OnChange="HandleFileUpload" class="form-control" />
                </div>

                @* 
              @if (uploadedFile != null)
                {
                    <div class="mt-3 p-3 border rounded bg-light">

                        <!-- File Info -->
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark text-primary"></i>
                                <strong>@uploadedFile.Name</strong>
                            </div>

                            <span class="badge bg-success">
                                <i class="bi bi-check-circle me-1"></i> Uploaded
                            </span>
                        </div>

                        <!-- Actions -->
                        <div class="mt-2 d-flex gap-3">

                            <!-- Preview Link -->
                            @if (!string.IsNullOrEmpty(filePreviewUrl))
                            {
                                <a href="@filePreviewUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i> Preview
                                </a>
                            }

                            <!-- Optional Remove -->
                            <button class="btn btn-sm btn-outline-danger" @onclick="RemoveFile">
                                <i class="bi bi-trash me-1"></i> Remove
                            </button>
                        </div>
                    </div>
                }
                *@
                <small class="text-muted">
                    Please note: A sick note is required for absences on a Monday or Friday, or for two consecutive sick days.
                    Supporting documents are required for family leave.
                </small>
            </div>
        }
        <!-- Buttons -->
        <div class="col-12 text-end mt-3">
            <button type="submit" class="btn btn save-btn px-4 py-2 me-3" disabled="@(!CanSubmit())">Apply Leave</button>
            <button type="button" class="btn btn-outline-secondary px-5 py-2" @onclick="GoBack">Cancel</button>
        </div>
    </EditForm>
</div>

@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <div class="alert alert-success text-center">@SuccessMessage</div>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger text-center">@ErrorMessage</div>
}

@if (IsLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner">
            <i class="fas fa-spinner fa-spin"></i>
            <p>@LoadingMessage</p>
        </div>
    </div>
}

@code {

    [Parameter]
    public string Email { get; set; } = "";

    private LeaveModel Leave = new();

    private bool IsLoading = false;
    private string LoadingMessage = "";
    private string SuccessMessage = "";
    private string ErrorMessage = "";
    public string UserName { get; set; } = "";
    public string UserEmail { get; set; } = "";
    public string  lastName { get; set; } = "";
    public string Initials { get; set; } = "";
    private string? imagePreviewUrl;
    private string? filePreviewUrl;
    private IBrowserFile? uploadedFile;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUserFromToken();
        }
    }

    private async Task LoadUserFromToken()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (string.IsNullOrEmpty(token)) return;

            var handler = new JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(token);

            UserName = jwt.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? "";
            UserEmail = jwt.Claims.FirstOrDefault(c => c.Type == "Email")?.Value ?? "";
            lastName=jwt.Claims.FirstOrDefault(c => c.Type == "lastName")?.Value ?? "";

            Leave.Email = UserEmail;


            if (!string.IsNullOrWhiteSpace(UserName)&& !string.IsNullOrWhiteSpace(lastName))
            {
                // Combine first letter of first part of UserName and first letter of lastName
                var parts = UserName.Split(' ');
                Initials = parts.Length >= 1
                    ? $"{parts[0][0]}{lastName[0]}".ToUpper()
                    : $"{lastName[0]}".ToUpper();
            }
            Leave.EmployeeName = UserName + " " + lastName;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("JWT READ ERROR: " + ex.Message);
        }
    }
    private void HandleFileUpload(InputFileChangeEventArgs e)
    {
        uploadedFile = e.File;
    }

    private void RemoveFile()
    {
        uploadedFile = null;
        filePreviewUrl = null;
    }
  
    private void CalculateDays()
    {
        ErrorMessage = "";

        if (Leave.StartDate == default || Leave.EndDate == default)
            return;

        if (Leave.EndDate < Leave.StartDate)
        {
            Leave.NumberOfDays = 0;
            ErrorMessage = "End date cannot be before start date";
            return;
        }

        Leave.NumberOfDays = (Leave.EndDate - Leave.StartDate).Days + 1;
    }

    private void PrepareDates()
    {
        Leave.StartDate = Leave.StartDate.Date;
        Leave.EndDate = Leave.EndDate.Date;
    }
private bool CanSubmit()
{
    if (string.IsNullOrWhiteSpace(Leave.LeaveType))
        return false;

    if (Leave.StartDate == default || Leave.EndDate == default)
        return false;

    if (Leave.EndDate < Leave.StartDate)
        return false;

    if (string.IsNullOrWhiteSpace(Leave.Reason))
        return false;

    //  FAMILY LEAVE → ALWAYS REQUIRE DOCUMENT
    if (Leave.LeaveType == "Family" && uploadedFile == null)
        return false;

    //  SICK LEAVE RULES
    if (Leave.LeaveType == "Sick")
    {
        bool isMondayOrFriday =
            Leave.StartDate.DayOfWeek == DayOfWeek.Monday ||
            Leave.StartDate.DayOfWeek == DayOfWeek.Friday ||
            Leave.EndDate.DayOfWeek == DayOfWeek.Monday ||
            Leave.EndDate.DayOfWeek == DayOfWeek.Friday;

        int days = (Leave.EndDate - Leave.StartDate).Days + 1;

        bool isTwoOrMoreDays = days >= 2;

        if ((isMondayOrFriday || isTwoOrMoreDays) && uploadedFile == null)
            return false;
    }

    return true;
}
    private async Task ApplyLeave()
    {
        try
        {
            IsLoading = true;
            LoadingMessage = "Submitting leave...";

            PrepareDates();

            var content = new MultipartFormDataContent();

            // TEXT FIELDS
            content.Add(new StringContent(Leave.EmployeeName ?? ""), "EmployeeName");
            content.Add(new StringContent(Leave.LeaveType ?? ""), "LeaveType");
            content.Add(new StringContent(Leave.Reason ?? ""), "Reason");

            content.Add(new StringContent(Leave.StartDate.ToString("yyyy-MM-dd")), "StartDate");
            content.Add(new StringContent(Leave.EndDate.ToString("yyyy-MM-dd")), "EndDate");

            // FILE (Sick + Family only)
            if (uploadedFile != null &&
                (Leave.LeaveType == "Sick" || Leave.LeaveType == "Family"))
            {
                var stream = uploadedFile.OpenReadStream(10 * 1024 * 1024);

                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType =
                    new System.Net.Http.Headers.MediaTypeHeaderValue(uploadedFile.ContentType);

                content.Add(fileContent, "Document", uploadedFile.Name);
            }

            var response = await Http.PostAsync(
                $"https://localhost:7043/api/Leave/apply?email={Leave.Email}",
                content
            );

            if (response.IsSuccessStatusCode)
            {
                IsLoading = false;
                SuccessMessage = "Leave applied successfully!";
                ErrorMessage = "";
                // KEEP EMAIL + EMPLOYEE NAME
             var email = Leave.Email;
                var name = Leave.EmployeeName;
                // CLEAR FORM
                // RESET FORM
                Leave = new LeaveModel
                {
                    Email = email,
                    EmployeeName = name,
                    StartDate = DateTime.Today,
                    EndDate = DateTime.Today
                };

                uploadedFile = null;

                CalculateDays();

                StateHasChanged();

                await Task.Delay(2000);

                SuccessMessage = "";
               
            }
            else
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/dashboard");
    }

    public class LeaveModel
    {
        public string Email { get; set; } = "";
        public string EmployeeName { get; set; } = "";
        public string LeaveType { get; set; } = "";
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today;
        public int NumberOfDays { get; set; }
        public string Reason { get; set; } = "";
    }
}